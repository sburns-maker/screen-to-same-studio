# Server-only mature-photo replacement. Keep disabled until staging is reviewed.
SPICY_ENABLED=false
SPICY_API_KEY=
SPICY_MODEL=bytedance/seedream-5.0-flash/edit
# Optional per-character model overrides (same verified model allowlist):
# SPICY_MODEL_RILEY=bytedance/seedream-5.0-pro/edit
# SPICY_MODEL_TESS=bytedance/seedream-5.0-flash/edit
# Set from verified account pricing; never infer these from documentation samples.
SPICY_JOB_RESERVATION_CENTS=
SPICY_DAILY_BUDGET_CENTS=
SPICY_MONTHLY_BUDGET_CENTS=
# Exact trusted output CDN hosts, comma-separated; no wildcard or private hosts.
SPICY_OUTPUT_HOSTS=
# Actual time the operator verified usable API credit; ISO8601, expires after 24h.
SPICY_ACCOUNT_CREDITS_VERIFIED_AT=
# Existing normal-image/OpenAI, Supabase, world-worker and phone settings stay unchanged.
